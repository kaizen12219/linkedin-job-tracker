{
  "name": "linkedin-job-tracker-extension",
  "version": "0.8.2",
  "private": true,
  "description": "Capture LinkedIn and Jobright jobs directly in ApplicantAlly’s data folder, with automatic profile selection.",
  "scripts": {
    "test": "node scripts/check-version.cjs && node --test tests/*.test.js",
    "check:version": "node scripts/check-version.cjs",
    "preview:popup": "node tests/popup-preview-server.js",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "prepackage:extension": "node scripts/check-version.cjs"
  },
  "devDependencies": {
    "jsdom": "^27.4.0"
  }
}
