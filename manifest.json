{
  "manifest_version": 3,
  "name": "LinkedIn Job Scraper",
  "description": "Capture LinkedIn jobs in Kai Flow, with Google Sheets available for publishing.",
  "version": "0.6.1",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8787"
  },
  "action": {
    "default_title": "Save LinkedIn Job to Kai Sheet",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.linkedin.com/*"
  ],
  "commands": {
    "scrape-and-save-job": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Scrape the active LinkedIn job and save it to Kai Flow"
    },
    "toggle-job-collection": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Start or stop collecting active LinkedIn search results"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/jobs/search-results/*"
      ],
      "js": [
        "src/scraper.js",
        "src/detail-copy.js",
        "src/job-collector.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
