{
  "manifest_version": 3,
  "name": "LinkedIn Job Scraper",
  "description": "Capture LinkedIn jobs directly in a Google Sheet with an optional profile.",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://oauth2.googleapis.com https://sheets.googleapis.com"
  },
  "action": {
    "default_title": "Save LinkedIn Job to Kai Sheet",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "host_permissions": [
    "https://oauth2.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.linkedin.com/*"
  ],
  "commands": {
    "scrape-and-save-job": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Scrape the active LinkedIn job and save it to Google Sheets"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/jobs/search-results/*"
      ],
      "js": ["src/scraper.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
