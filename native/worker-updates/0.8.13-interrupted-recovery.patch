+        typeof approval.approvedAt !== "string" || !Number.isFinite(Date.parse(approval.approvedAt)) || seen.has(approval.requestId))
+        throw fail("Invalid exact-session operator recovery approval.", 503);
+      seen.add(approval.requestId);
+      const matches = this.records.filter(record => record.requestId === approval.requestId);
+      if (matches.length !== 1) throw fail("Operator recovery must identify one existing request.", 409);
+      const record = matches[0], existing = record.interruptedRecovery;
+      if (existing) {
+        if (!["requestId", "threadId", "turnId", "approvalId", "approvedAt"].every(key => existing[key] === approval[key]))
+          throw fail("This request already has a different operator recovery approval.", 409);
+        continue; // A crash or failed manifest cleanup must never replay a successor.
+      }
+      if (record.state !== "failed" || record.threadId !== approval.threadId || record.turnId !== approval.turnId ||
+        record.result !== undefined || record.resultFingerprint !== undefined || record.cancelledAt || record.cancelRequestedAt ||
+        (record.diagnostics?.events || []).some(event => event.type === "decision-accepted") ||
+        this.clock() - record.createdAt > 86400000 || this.clock() - Date.parse(approval.approvedAt) > 86400000 ||
+        Date.parse(approval.approvedAt) > this.clock() + 60000) throw fail("The exact interrupted request is no longer eligible for operator recovery.", 409);
+      pending.push({ record, approval });
+    }
+    if (pending.length) {
+      const claims = await this.loadSaveClaims();
+      if (pending.some(({ record }) => claims.some(claim => claim.requestId === record.requestId))) throw fail("A request with save ownership cannot be recovered.", 409);
+      for (const { record, approval } of pending) {
+        const operationId = `research:${record.requestId}:${record.client.slice(0, 16)}`;
+        await this.dispatcher.authorizeInterruptedRecovery(operationId, approval);
+      }
+      for (const { record, approval } of pending) {
+        record.interruptedRecovery = clone(approval);
+        record.recoverableResearchFailure = true;
+        record.state = "queued";
+        record.retryFailed = true;
+        delete record.error; delete record.retryAt; delete record.completedAt;
+        this.diagnosticEvent(record, "operator-interruption-recovery-approved", {
+          reason: "The user explicitly authorized resuming this exact interrupted research session.", threadId: approval.threadId, turnId: approval.turnId });
+      }
+      await this.persist();
+    }
+    // The durable request and ledger retain the approval proof. Leaving a
+    // locked manifest behind is harmless: its exact approval is idempotent.
+    await fs.unlink(this.interruptedRecoveriesFile).catch(() => {});
+  }
